// Start Twilio conference call between two phone numbers.
app.post('/api/start-call', async (req, res) => {
  try {
    const { userA, userB, caller_phone, qr_code_id, roomId = 'demo' } = req.body;
    const {
      TWILIO_ACCOUNT_SID,
      TWILIO_AUTH_TOKEN,
      TWILIO_PHONE_NUMBER,
    } = process.env;

    if (!TWILIO_ACCOUNT_SID || !TWILIO_AUTH_TOKEN || !TWILIO_PHONE_NUMBER) {
      return res.status(500).json({
        success: false,
        error: 'Twilio credentials are not configured',
      });
    }

    let resolvedCaller = userA || caller_phone || null;
    let resolvedReceiver = userB || null;
    let resolvedRoomId = roomId || qr_code_id || 'demo';

    if ((!resolvedCaller || !resolvedReceiver) && qr_code_id) {
      const [rows] = await pool.execute(
        `SELECT
           COALESCE(NULLIF(v.mobile_number, ''), u.phone) AS owner_phone
         FROM qr_codes qc
         JOIN users u ON qc.user_id = u.id
    LEFT JOIN vehicles v ON qc.vehicle_id = v.id
        WHERE qc.qr_code_id = ? AND qc.is_active = TRUE
        LIMIT 1`,
        [qr_code_id]
      );

      if (rows.length === 0) {
        return res.status(404).json({
          success: false,
          error: 'QR code not found or inactive',
        });
      }

      resolvedReceiver = resolvedReceiver || rows[0].owner_phone;
      resolvedRoomId = resolvedRoomId || qr_code_id;
    }

    if (!resolvedCaller || !resolvedReceiver) {
      return res.status(400).json({
        success: false,
        error: 'Provide userA and userB, or caller_phone and a valid qr_code_id',
      });
    }

    resolvedCaller = notificationService.formatPhoneNumber(resolvedCaller);
    resolvedReceiver = notificationService.formatPhoneNumber(resolvedReceiver);

    const client = twilio(TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN);
    const conferenceTwiml = buildConferenceTwiml(resolvedRoomId);

    await Promise.all([
      client.calls.create({
        to: resolvedCaller,
        from: TWILIO_PHONE_NUMBER,
        twiml: conferenceTwiml,
      }),
      client.calls.create({
        to: resolvedReceiver,
        from: TWILIO_PHONE_NUMBER,
        twiml: conferenceTwiml,
      }),
    ]);

    return res.json({
      success: true,
      message: 'Calling both users...',
      roomId: resolvedRoomId,
    });
  } catch (err) {
    console.error('Twilio start call failed:', err);
    return res.status(500).json({
      success: false,
      error: err?.code === 21219
        ? 'Twilio trial accounts can only call verified numbers. Verify both numbers or upgrade the account.'
        : err?.code === 21608
          ? 'Twilio trial accounts can only send SMS to verified numbers.'
          : err.message,
    });
  }
});

// Fetch the latest Twilio call status, optionally filtered by phone number.
app.get('/api/call-status', async (req, res) => {
  try {
    const { phone, limit = '5' } = req.query;
    const {
      TWILIO_ACCOUNT_SID,
      TWILIO_AUTH_TOKEN,
    } = process.env;

    if (!TWILIO_ACCOUNT_SID || !TWILIO_AUTH_TOKEN) {
      return res.status(500).json({
        success: false,
        error: 'Twilio credentials are not configured',
      });
    }

    const parsedLimit = Math.min(Math.max(parseInt(limit, 10) || 5, 1), 20);
    const client = twilio(TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN);
    const calls = await client.calls.list({ limit: parsedLimit });

    const normalizedPhone = phone ? String(phone).trim() : '';
    const filteredCalls = normalizedPhone
      ? calls.filter((call) =>
          String(call.to || '').includes(normalizedPhone) ||
          String(call.from || '').includes(normalizedPhone)
        )
      : calls;

    const latestCall = filteredCalls[0] || null;

    return res.json({
      success: true,
      count: filteredCalls.length,
      latest: latestCall
        ? {
            sid: latestCall.sid,
            status: latestCall.status,
            from: latestCall.from,
            to: latestCall.to,
            direction: latestCall.direction,
            duration: latestCall.duration,
            startTime: latestCall.startTime,
            endTime: latestCall.endTime,
            price: latestCall.price,
            priceUnit: latestCall.priceUnit,
            errorCode: latestCall.errorCode,
            errorMessage: latestCall.errorMessage,
          }
        : null,
      calls: filteredCalls.map((call) => ({
        sid: call.sid,
        status: call.status,
        from: call.from,
        to: call.to,
        direction: call.direction,
        duration: call.duration,
        startTime: call.startTime,
        endTime: call.endTime,
        price: call.price,
        priceUnit: call.priceUnit,
        errorCode: call.errorCode,
        errorMessage: call.errorMessage,
      })),
    });
  } catch (err) {
    console.error('Twilio call status fetch failed:', err);
    return res.status(500).json({
      success: false,
      error: err.message,
    });
  }
});

