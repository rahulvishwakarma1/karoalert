router.get('/profile', authenticateToken, async (req, res) => {
  try {
    await ensureMembershipExpiryColumn();

    const [users] = await pool.execute(
      `SELECT id, name, email, phone, car_number, qr_code_id, is_admin, role,
              membership_status, membership_expires_at, can_create_qr, can_hide_number, created_at
         FROM users WHERE id = ?`,
      [req.user.userId]
    );

    if (users.length === 0) {
      return res.status(404).json({ error: 'User not found' });
    }

    const user = await normalizeMembership(users[0]);

    // Get QR code if exists
    const [qrCodes] = await pool.execute(
      `SELECT qr_code_id, qr_data, is_active FROM qr_codes
         WHERE user_id = ? AND is_active = TRUE
         LIMIT 1`,
      [user.id]
    );

    let activePlan = null;
    if (isMembershipActive(user)) {
      const [planRows] = await pool.execute(
        `SELECT mp.id, mp.name, mp.qr_limit, mp.duration_days
           FROM payment_records pr
           JOIN membership_plans mp ON mp.id = pr.plan_id
          WHERE pr.user_id = ? AND pr.status = 'paid'
          ORDER BY pr.id DESC LIMIT 1`,
        [user.id]
      );
      activePlan = planRows[0] || null;
    }

    const response = {
      id: user.id, name: user.name, email: user.email,
      phone: user.phone, car_number: user.car_number || null,
      qr_code_id: user.qr_code_id,
      role: user.role || (user.is_admin ? 'admin' : 'user'),
      is_admin: !!user.is_admin || ['subadmin', 'admin'].includes(user.role),
      membership_status: user.membership_status || 'inactive',
      membership_expires_at: user.membership_expires_at || null,
      membership_active: isMembershipActive(user),
      can_create_qr: !!user.can_create_qr,
      can_hide_number: !!user.can_hide_number,
      active_plan: activePlan,
      created_at: user.created_at
    };

    if (qrCodes.length > 0) {
      response.qr_code_id = qrCodes[0].qr_code_id;
      response.qr_active = qrCodes[0].is_active;
    }

    res.json({ user: response });
  } catch (error) {
    console.error('Profile error:', error);
    res.status(500).json({ error: 'Failed to fetch profile' });
  }
});

