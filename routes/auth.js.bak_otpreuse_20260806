const express = require('express');
const { body, validationResult } = require('express-validator');
const { pool } = require('../config/database');
const { authenticateToken } = require('../middleware/auth');
const jwt = require('jsonwebtoken');
const emailService = require('../services/emailService');
const notificationService = require('../services/notificationService');
const pushService = require('../services/pushService');

const router = express.Router();

const ensureMembershipExpiryColumn = async () => {
  const [columns] = await pool.execute(
    `SELECT COLUMN_NAME
       FROM INFORMATION_SCHEMA.COLUMNS
      WHERE TABLE_SCHEMA = DATABASE()
        AND TABLE_NAME = 'users'
        AND COLUMN_NAME = 'membership_expires_at'`
  );
  if (columns.length === 0) {
    await pool.execute('ALTER TABLE users ADD COLUMN membership_expires_at DATETIME NULL AFTER membership_status');
  }
  await pool.execute(
    `UPDATE users
        SET membership_expires_at = DATE_ADD(NOW(), INTERVAL 1 YEAR)
      WHERE membership_status = 'active'
        AND membership_expires_at IS NULL`
  );
};

const isMembershipActive = (user) =>
  user.membership_status === 'active' &&
  !!user.can_create_qr &&
  (!user.membership_expires_at || new Date(user.membership_expires_at) > new Date());

const normalizeMembership = async (user) => {
  if (
    user.membership_status === 'active' &&
    user.membership_expires_at &&
    new Date(user.membership_expires_at) <= new Date()
  ) {
    await pool.execute(
      `UPDATE users
          SET membership_status = 'inactive',
              can_create_qr = FALSE
        WHERE id = ?`,
      [user.id]
    );
    return {
      ...user,
      membership_status: 'inactive',
      can_create_qr: false,
    };
  }

  return user;
};

const ensurePasswordResetOtpTable = async () => {
  await pool.execute(`
    CREATE TABLE IF NOT EXISTS password_reset_otps (
      id INT AUTO_INCREMENT PRIMARY KEY,
      user_id INT NOT NULL,
      email VARCHAR(255) NULL,
      phone VARCHAR(20) NULL,
      otp VARCHAR(4) NOT NULL,
      status ENUM('requested', 'auto_accepted', 'verified', 'expired', 'failed') DEFAULT 'requested',
      send_status ENUM('pending', 'sent', 'failed') DEFAULT 'pending',
      send_error TEXT NULL,
      expires_at DATETIME NOT NULL,
      verified_at DATETIME NULL,
      created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
      INDEX idx_email (email),
      INDEX idx_phone (phone),
      INDEX idx_status (status),
      INDEX idx_expires_at (expires_at)
    )
  `);

  const [columns] = await pool.execute(
    `SELECT COLUMN_NAME, IS_NULLABLE
       FROM INFORMATION_SCHEMA.COLUMNS
      WHERE TABLE_SCHEMA = DATABASE()
        AND TABLE_NAME = 'password_reset_otps'`
  );
  const columnMap = new Map(columns.map((column) => [column.COLUMN_NAME, column]));

  if (!columnMap.has('email')) {
    await pool.execute('ALTER TABLE password_reset_otps ADD COLUMN email VARCHAR(255) NULL AFTER user_id');
    await pool.execute('CREATE INDEX idx_email ON password_reset_otps (email)');
  }
  if (columnMap.get('phone')?.IS_NULLABLE === 'NO') {
    await pool.execute('ALTER TABLE password_reset_otps MODIFY phone VARCHAR(20) NULL');
  }
};

const generateOtp = () => String(Math.floor(1000 + Math.random() * 9000));

const ensureRegisterOtpTable = async () => {
  await pool.execute(`
    CREATE TABLE IF NOT EXISTS register_otps (
      id INT AUTO_INCREMENT PRIMARY KEY,
      phone VARCHAR(20) NOT NULL,
      email VARCHAR(255) NULL,
      name VARCHAR(100) NULL,
      password VARCHAR(255) NULL,
      car_number VARCHAR(50) NULL,
      otp VARCHAR(4) NOT NULL,
      status ENUM('pending', 'verified', 'expired') DEFAULT 'pending',
      expires_at DATETIME NOT NULL,
      verified_at DATETIME NULL,
      created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
      INDEX idx_phone (phone),
      INDEX idx_status (status)
    )
  `);
};

const createRegisteredUser = async ({ name, email, phone, password, car_number }) => {
  await ensureMembershipExpiryColumn();

  const [result] = await pool.execute(
    `INSERT INTO users (name, email, phone, password, car_number, membership_status, can_create_qr, can_hide_number)
     VALUES (?, ?, ?, ?, ?, 'inactive', FALSE, FALSE)`,
    [name, email, phone, password, car_number || null]
  );

  const userId = result.insertId;

  let qrCodeId = null;
  let qrImage = null;
  if (car_number) {
    const qrcode = require('qrcode');
    const { v4: uuidv4 } = require('uuid');

    qrCodeId = uuidv4();
    const qrUrl = `${process.env.APP_URL || 'https://app.shreesswpl.com/'}/public/${qrCodeId}`;
    qrImage = await qrcode.toDataURL(qrUrl);

    const qrData = JSON.stringify({
      userId,
      userName: name,
      userMobile: phone,
      carNumber: car_number,
      vehicleId: null
    });

    await pool.execute(
      `INSERT INTO qr_codes (user_id, vehicle_id, qr_code_id, qr_data)
       VALUES (?, NULL, ?, ?)`,
      [userId, qrCodeId, qrData]
    );

    await pool.execute(
      'UPDATE users SET qr_code_id = ? WHERE id = ?',
      [qrCodeId, userId]
    );
  }

  return { userId, qrCodeId, qrImage };
};

// ── Register (Mobile OTP) ─────────────────────────────────────────────
router.post('/register/send-otp', [
  body('name').trim().isLength({ min: 2, max: 100 }).withMessage('Name must be 2-100 characters'),
  body('email').isEmail().normalizeEmail().withMessage('Valid email required'),
  body('phone').trim().matches(/^\d{10}$/).withMessage('Phone number must be exactly 10 digits'),
  body('password').isLength({ min: 6 }).withMessage('Password must be at least 6 characters'),
  body('car_number').optional().trim().isLength({ max: 50 })
], async (req, res) => {
  try {
    await ensureRegisterOtpTable();

    const errors = validationResult(req);
    if (!errors.isEmpty()) {
      return res.status(400).json({ errors: errors.array() });
    }

    const { name, email, phone, password, car_number } = req.body;

    const [existing] = await pool.execute(
      'SELECT id FROM users WHERE email = ? OR phone = ?',
      [email, phone]
    );
    if (existing.length > 0) {
      return res.status(409).json({ error: 'User with this email or phone already exists' });
    }

    const otp = generateOtp();
    const expiresAt = new Date(Date.now() + 10 * 60 * 1000);

    await pool.execute(
      `UPDATE register_otps
          SET status = 'expired'
        WHERE phone = ? AND status = 'pending'`,
      [phone]
    );

    const [result] = await pool.execute(
      `INSERT INTO register_otps
        (phone, email, name, password, car_number, otp, status, expires_at)
       VALUES (?, ?, ?, ?, ?, ?, 'pending', ?)`,
      [phone, email, name, password, car_number || null, otp, expiresAt]
    );

    const smsResult = await notificationService.sendSMS(
      phone,
      `Your KaroAlert registration OTP is ${otp}. It is valid for 10 minutes.`
    );

    if (!smsResult.success) {
      console.error('Register OTP SMS failed:', smsResult.error);
    }

    res.json({
      message: 'OTP sent to your mobile number. It is valid for 10 minutes.',
      expires_in_seconds: 600,
      sms_sent: !!smsResult.success,
      request_id: result.insertId,
    });
  } catch (error) {
    console.error('Register OTP error:', error);
    res.status(500).json({ error: 'Failed to send OTP' });
  }
});

router.post('/register/verify-otp', [
  body('phone').trim().matches(/^\d{10}$/).withMessage('Phone number must be exactly 10 digits'),
  body('otp').trim().matches(/^\d{4}$/).withMessage('OTP must be exactly 4 digits')
], async (req, res) => {
  try {
    await ensureRegisterOtpTable();

    const errors = validationResult(req);
    if (!errors.isEmpty()) {
      return res.status(400).json({ errors: errors.array() });
    }

    const { phone, otp } = req.body;

    const [rows] = await pool.execute(
      `SELECT id, email, name, password, car_number
         FROM register_otps
        WHERE phone = ?
          AND otp = ?
          AND status = 'pending'
          AND expires_at > NOW()
        ORDER BY created_at DESC
        LIMIT 1`,
      [phone, otp]
    );

    if (rows.length === 0) {
      return res.status(400).json({ error: 'Invalid or expired OTP' });
    }

    const pending = rows[0];

    await pool.execute(
      `UPDATE register_otps
          SET status = 'expired'
        WHERE phone = ? AND status = 'pending'`,
      [phone]
    );

    await createRegisteredUser({
      name: pending.name,
      email: pending.email,
      phone,
      password: pending.password,
      car_number: pending.car_number,
    });

    await pool.execute(
      `UPDATE register_otps
          SET status = 'verified', verified_at = NOW()
        WHERE id = ?`,
      [pending.id]
    );

    res.json({
      message: 'Phone number verified. Your account is created. Please login.',
    });
  } catch (error) {
    console.error('Register verify OTP error:', error);
    res.status(500).json({ error: 'Failed to verify OTP' });
  }
});

// ── Login ──────────────────────────────────────────────────────────────
router.post('/login', [
  body('email').optional().isEmail().normalizeEmail().withMessage('Valid email required'),
  body('identifier').optional().isEmail().normalizeEmail().withMessage('Valid email required'),
  body('password').notEmpty().withMessage('Password required')
], async (req, res) => {
  try {
    await ensureMembershipExpiryColumn();

    const errors = validationResult(req);
    if (!errors.isEmpty()) {
      return res.status(400).json({ errors: errors.array() });
    }

    const email = req.body.email || req.body.identifier;
    const { password } = req.body;

    if (!email) {
      return res.status(400).json({ errors: [{ msg: 'Valid email required', param: 'email' }] });
    }

    const [users] = await pool.execute(
      `SELECT id, name, email, phone, password, car_number, qr_code_id,
              is_admin, role, membership_status, membership_expires_at, can_create_qr, can_hide_number, created_at
         FROM users WHERE email = ?`,
      [email]
    );

    if (users.length === 0) {
      return res.status(401).json({ error: 'Invalid credentials' });
    }

    let user = users[0];

    // Compare plain-text password (demo mode)
    if (user.password !== password) {
      return res.status(401).json({ error: 'Invalid credentials' });
    }

    user = await normalizeMembership(user);

    const token = jwt.sign(
      { userId: user.id, email: user.email, name: user.name, is_admin: !!user.is_admin },
      process.env.JWT_SECRET,
      { expiresIn: process.env.JWT_EXPIRE || '7d' }
    );

    // Get QR code data if available
    let qr_code_id = user.qr_code_id;
    let qr_image = null;
    if (qr_code_id) {
      const [qrCodes] = await pool.execute(
        `SELECT qr_code_id, qr_data FROM qr_codes
          WHERE qr_code_id = ? AND is_active = TRUE`,
        [qr_code_id]
      );
      if (qrCodes.length > 0) {
        qr_image = await require('qrcode').toDataURL(
          `${process.env.APP_URL || 'https://app.shreesswpl.com/'}/public/${qr_code_id}`
        );
      }
    }

    res.json({
      message: 'Login successful',
      token,
      user: {
        id: user.id,
        name: user.name,
        email: user.email,
        phone: user.phone,
        car_number: user.car_number,
        qr_code_id,
        role: user.role || (user.is_admin ? 'admin' : 'user'),
        is_admin: !!user.is_admin || ['subadmin', 'admin'].includes(user.role),
        membership_status: user.membership_status || 'inactive',
        membership_expires_at: user.membership_expires_at || null,
        membership_active: isMembershipActive(user),
        can_create_qr: !!user.can_create_qr,
        can_hide_number: !!user.can_hide_number,
        created_at: user.created_at
      },
      qr_image
    });
  } catch (error) {
    console.error('Login error:', error);
    res.status(500).json({ error: 'Login failed' });
  }
});

router.post('/forgot-password/request-otp', [
  body('email').optional().isEmail().normalizeEmail().withMessage('Valid email required'),
  body('username').optional().isEmail().normalizeEmail().withMessage('Valid email required'),
  body('identifier').optional().isEmail().normalizeEmail().withMessage('Valid email required')
], async (req, res) => {
  try {
    await ensurePasswordResetOtpTable();

    const errors = validationResult(req);
    if (!errors.isEmpty()) {
      return res.status(400).json({ errors: errors.array() });
    }

    const email = req.body.email || req.body.username || req.body.identifier;
    if (!email) {
      return res.status(400).json({ errors: [{ msg: 'Registered email is required', param: 'email' }] });
    }

    const [users] = await pool.execute(
      'SELECT id, name, email, phone FROM users WHERE email = ?',
      [email]
    );

    if (users.length === 0) {
      return res.status(404).json({ error: 'No account found with this email' });
    }

    const user = users[0];
    const otp = generateOtp();
    const expiresAt = new Date(Date.now() + 10 * 60 * 1000);

    await pool.execute(
      `UPDATE password_reset_otps
          SET status = 'expired'
        WHERE user_id = ? AND status IN ('requested', 'auto_accepted')`,
      [user.id]
    );

    const [result] = await pool.execute(
      `INSERT INTO password_reset_otps
        (user_id, email, otp, status, send_status, expires_at)
       VALUES (?, ?, ?, 'auto_accepted', 'pending', ?)`,
      [user.id, user.email, otp, expiresAt]
    );

    let emailStatus = 'not_configured';
    let smsStatus = 'not_configured';
    let smsError = null;

    try {
      await emailService.sendPasswordOtp(user.email, otp, user.name);
      emailStatus = 'sent';
    } catch (sendError) {
      emailStatus = 'failed';
      console.error('Password OTP email failed:', sendError.message);
    }

    if (user.phone) {
      const smsResult = await notificationService.sendSMS(
        user.phone,
        `Your KaroAlert password reset OTP is ${otp}. It is valid for 10 minutes.`
      );
      smsStatus = smsResult.success ? 'sent' : 'failed';
      smsError = smsResult.error || null;
      if (!smsResult.success) console.error('Password OTP SMS failed:', smsError);
    } else {
      smsStatus = 'no_phone';
    }

    const sendStatus = (emailStatus === 'sent' || smsStatus === 'sent') ? 'sent' : 'failed';
    const sendErrorText = [emailStatus, smsStatus]
      .filter((s) => s === 'failed')
      .join(', ');

    await pool.execute(
      `UPDATE password_reset_otps
          SET send_status = ?, send_error = ?
        WHERE id = ?`,
      [sendStatus, sendErrorText || null, result.insertId]
    );

    if (emailStatus === 'failed' && smsStatus === 'failed') {
      return res.status(500).json({
        error: 'OTP generated but both email and SMS delivery failed',
        details: smsError || 'Email and SMS sending failed',
      });
    }

    res.json({
      message: 'OTP sent to your registered email and mobile number. It is valid for 10 minutes.',
      expires_in_seconds: 600,
      email_sent: emailStatus === 'sent',
      sms_sent: smsStatus === 'sent',
    });
  } catch (error) {
    console.error('Update password OTP error:', error);
    res.status(500).json({ error: 'Failed to send OTP' });
  }
});

router.post('/forgot-password/reset', [
  body('email').optional().isEmail().normalizeEmail().withMessage('Valid email required'),
  body('username').optional().isEmail().normalizeEmail().withMessage('Valid email required'),
  body('identifier').optional().isEmail().normalizeEmail().withMessage('Valid email required'),
  body('otp').trim().matches(/^\d{4}$/).withMessage('OTP must be exactly 4 digits'),
  body('newPassword').isLength({ min: 6 }).withMessage('Password must be at least 6 characters')
], async (req, res) => {
  try {
    await ensurePasswordResetOtpTable();

    const errors = validationResult(req);
    if (!errors.isEmpty()) {
      return res.status(400).json({ errors: errors.array() });
    }

    const email = req.body.email || req.body.username || req.body.identifier;
    const { otp, newPassword } = req.body;
    if (!email) {
      return res.status(400).json({ errors: [{ msg: 'Registered email is required', param: 'email' }] });
    }

    const [rows] = await pool.execute(
      `SELECT pro.id, pro.user_id
         FROM password_reset_otps pro
         JOIN users u ON u.id = pro.user_id
        WHERE pro.email = ?
          AND pro.otp = ?
          AND pro.status = 'auto_accepted'
          AND pro.expires_at > NOW()
        ORDER BY pro.created_at DESC
        LIMIT 1`,
      [email, otp]
    );

    if (rows.length === 0) {
      return res.status(400).json({ error: 'Invalid or expired OTP' });
    }

    const resetRequest = rows[0];

    await pool.execute(
      'UPDATE users SET password = ? WHERE id = ?',
      [newPassword, resetRequest.user_id]
    );

    await pool.execute(
      `UPDATE password_reset_otps
          SET status = 'verified', verified_at = NOW()
        WHERE id = ?`,
      [resetRequest.id]
    );

    res.json({ message: 'Password updated successfully. Please login with your new password.' });
  } catch (error) {
    console.error('Update password reset error:', error);
    res.status(500).json({ error: 'Failed to reset password' });
  }
});

